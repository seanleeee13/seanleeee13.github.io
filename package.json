{
    "name": "seanleeee13-github-pages",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@12.4.1",
    "scripts": {
        "dev:main": "pnpm --filter main dev",
        "dev:gff": "pnpm --filter main --filter gff --parallel dev",
        "dev:something": "pnpm --filter main --filter something --parallel dev",
        "dev:stage": "pnpm --filter main --filter stage -parallel dev",
        "dev:all": "pnpm -r --parallel dev"
    }
}